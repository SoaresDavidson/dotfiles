unbind r
bind r source-file ~/.config/tmux/tmux.conf \; display-message "Configuração recarregada!"
# Muda o prefixo de Ctrl+b para Ctrl+a (muito mais confortável para a mão)
unbind C-b
set -g prefix C-a
bind C-a send-prefix
# Mudar para janela específica com Alt + 0..9 sem prefixo
bind-key -n M-0 select-window -t 0
bind-key -n M-1 select-window -t 1
bind-key -n M-2 select-window -t 2
bind-key -n M-3 select-window -t 3
bind-key -n M-4 select-window -t 4
bind-key -n M-5 select-window -t 5
bind-key -n M-6 select-window -t 6
bind-key -n M-7 select-window -t 7
bind-key -n M-8 select-window -t 8
bind-key -n M-9 select-window -t 9

# Alternar entre janelas anteriores e próximas com Alt + h/l
bind-key -n M-h previous-window
bind-key -n M-l next-window

# Ou usando as setas com Alt + Esquerda/Direita
bind-key -n M-Left  previous-window
bind-key -n M-Right next-window

# Criar nova janela com Alt + c
 bind-key -n M-c new-window -c "#{pane_current_path}"
# Fechar janela atual com Alt + q (pede confirmação)
bind-key -n M-q confirm-before -p "Kill window #W? (y/n)" kill-window

# Começa a numeração das janelas e painéis no 1 em vez do 0 (mais fácil de alcançar no teclado)
set -g base-index 1
set -g pane-base-index 1

# Atalhos mais intuitivos para dividir a tela (usa | para vertical e - para horizontal)
set-option -g status-position top
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
unbind '"'
unbind %

# Lista de plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
# set -g @plugin 'IngoMeyer441/tmux-easy-motion'
set -g @plugin 'christoomey/vim-tmux-navigator'
# set -g @plugin 'catppuccin/tmux#v2.3.0'
set -g @plugin 'arcticicestudio/nord-tmux'
set -g @plugin 'tmux-plugins/tmux-cpu'
set -g @plugin 'tmux-plugins/tmux-battery'
set -g @plugin 'tmux-plugins/tmux-continuum'
# Auto-restore do continuum desligado: a checagem de "outro servidor rodando" dele
# corre em paralelo com os comandos `tmux` dos outros plugins e pula o restore.
# O restore é feito manualmente no fim deste arquivo.
set -g @continuum-restore 'off'

# ~/.tmux.conf

# Options to make tmux more pleasant
set -g mouse on
set -g default-terminal "tmux-256color"
# Propaga cópias do buffer do tmux ao clipboard do terminal via OSC 52.
set -g set-clipboard on

# Inicializa o TMUX plugin manager (deve ser a ÚLTIMA linha do arquivo)
run '~/.config/tmux/plugins/tpm/tpm'

# Restaura a última sessão salva pelo resurrect só quando o servidor acabou de subir
# (1 sessão com 1 janela). Recarregar a config com prefix+r não dispara de novo.
run-shell -b 'sleep 1; [ "$(tmux list-sessions | wc -l)" -eq 1 ] && [ "$(tmux list-windows | wc -l)" -eq 1 ] && ~/.config/tmux/plugins/tmux-resurrect/scripts/restore.sh'
