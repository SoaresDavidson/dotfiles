alias gs="git status"
alias ga="git add"
alias gc="git commit"
alias gp="git pull"
alias glog='PAGER="less -F -X" git log'                              # -F quit if one screen, -X no clear on exit
alias gadog='PAGER="less -F -X" git log --all --decorate --oneline --graph'
alias gpp="git push"
alias gsm="git switch main"

